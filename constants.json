{
  "ci_job": "test",
  "release_job": "release",
  "release_image": "ghcr.io/lycheehome/lychee-admin",
  "release_tag_format": "sha-{commit}",
  "release_signer_workflow": ".github/workflows/ci.yml",
  "domain": "lychee.land",
  "site_suffix": "-lychee-land",
  "site_name_pattern": "[a-z0-9](?:[a-z0-9-]*[a-z0-9])?-lychee-land",
  "max_resource_name_length": 63,
  "image_prefix": "ghcr.io/lycheehome/",
  "tag_pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]{0,127}$",
  "floating_tags": ["latest"],
  "release_tag_pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
  "reserved_ports": [8787, 2019],
  "site_min_port": 1024,
  "gate_codes": ["ok", "up-to-date", "ci-pending", "ci-failed", "ci-unknown", "env-mismatch", "retry-capped", "pin-unresolved", "declaration-rejected", "not-applied", "awaiting-image", "image-unavailable", "provenance-failed", "host-pending", "unknown"],
  "host_actions": ["start", "stop", "restart", "update"],
  "op_unit_pattern": "lychee-op-{unit}-{action}.service",
  "op_sudo_argv": ["/usr/bin/systemctl", "start", "--no-block", "{op_unit}"],
  "client_socket_path": "/run/lychee-admin/clients/{client}/api.sock",
  "clients_file": "/etc/lychee-admin/clients.json",
  "op_result_path": "/var/lib/lychee-op/{unit}-{action}.result.json",
  "paths": {
    "inventory": "/var/lib/lychee-inventory/services.json",
    "resource_status_dir": "/var/lib/lychee-resources",
    "caddyfile": "/etc/caddy/Caddyfile",
    "tunnel_config": "/etc/cloudflared/sites-config.yml",
    "sites_root": "/var/www",
    "app_release_root": "/usr/local/lib/lychee-admin"
  }
}
