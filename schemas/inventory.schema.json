{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LycheeHome/lychee-contract/schemas/inventory.schema.json",
  "title": "Service inventory (services.json)",
  "description": "Published by lychee-ops' inventory role (templates/services.json.j2). Declared services plus discovered sites.",
  "type": "object",
  "required": ["generated", "services"],
  "properties": {
    "generated": { "$ref": "common.schema.json#/$defs/timestamp" },
    "services": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "description": "One service. Either a systemd unit or a compose project, never both on the wire. A reconciled entry (a status file was read) always carries result and failed_attempts; its other status fields (version, target, commit, gate, last_run) may be omitted when empty (v1.0 producers write them as '', which still validates). An unreconciled entry carries no status fields.",
      "type": "object",
      "required": ["name", "kind", "group", "reconciled"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["unit", "container"] },
        "unit": { "type": "string", "minLength": 1 },
        "container": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "group": { "enum": ["reconciler", "service", "infrastructure"] },
        "reconciled": { "type": "boolean" },
        "version": {
          "description": "Installed tag, else the first 7 characters of the installed commit; '' when nothing is installed.",
          "type": "string"
        },
        "target": { "description": "The pinned tag, or ''.", "type": "string" },
        "commit": { "description": "The installed commit, or ''.", "type": "string" },
        "result": { "enum": ["deployed", "skipped", "blocked", "failed", "awaiting-image", "unknown"] },
        "gate": { "type": "string" },
        "gate_code": {
          "description": "From the status file's gate_code; absent when the status file has none or the entry is unreconciled. See A-GATE-1.",
          "enum": ["ok", "up-to-date", "ci-pending", "ci-failed", "ci-unknown", "env-mismatch", "retry-capped", "pin-unresolved", "declaration-rejected", "not-applied", "awaiting-image", "image-unavailable", "provenance-failed", "host-pending", "token-missing", "unknown"]
        },
        "last_run": {
          "description": "The status file's last_run, or '' when the status file has none (the template's fallback).",
          "anyOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "const": "" }]
        },
        "failed_attempts": { "type": "integer", "minimum": 0 },
        "available": { "type": "string", "minLength": 1 },
        "failed_step": { "type": "string", "minLength": 1 },
        "actions": {
          "description": "Host actions this unit offers (A-OPS-1). Unit entries only; a container entry may not carry it.",
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["start", "stop", "restart", "update"] }
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": { "kind": { "const": "unit" } },
          "required": ["unit"],
          "not": { "required": ["container"] }
        },
        {
          "properties": { "kind": { "const": "container" } },
          "required": ["container"],
          "not": { "anyOf": [{ "required": ["unit"] }, { "required": ["actions"] }] }
        }
      ],
      "if": { "properties": { "reconciled": { "const": true } } },
      "then": {
        "required": ["result", "failed_attempts"]
      },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["version"] }, { "required": ["target"] }, { "required": ["commit"] },
            { "required": ["result"] }, { "required": ["gate"] }, { "required": ["last_run"] },
            { "required": ["failed_attempts"] }, { "required": ["gate_code"] },
            { "required": ["available"] },
            { "required": ["failed_step"] }
          ]
        }
      }
    }
  }
}
