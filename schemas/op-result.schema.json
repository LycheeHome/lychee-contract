{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LycheeHome/lychee-contract/schemas/op-result.schema.json",
  "title": "Host-action result (<unit>-<action>.result.json)",
  "description": "Written by lychee-ops' recorder at op_result_path (A-OPS-1) as the first ExecStopPost of every action service, so it exists after the unit has been unloaded. `result` is systemd's $SERVICE_RESULT verbatim.",
  "type": "object",
  "required": ["unit", "action", "result", "exit_status", "started_at", "finished_at"],
  "properties": {
    "unit": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "action": { "enum": ["start", "stop", "restart", "update"] },
    "result": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
    "exit_status": { "type": ["integer", "null"] },
    "started_at": { "$ref": "#/$defs/time" },
    "finished_at": { "$ref": "#/$defs/time" }
  },
  "additionalProperties": false,
  "$defs": {
    "time": {
      "description": "ISO 8601 UTC, or null when systemd had no timestamp.",
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
